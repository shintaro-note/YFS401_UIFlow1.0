{"category":"YFS401","color":"#0000ff","blocks":["__YFS401_init","__YFS401_update","__YFS401_lpm"],"jscode":"// Block __YFS401_init\nvar __YFS401_init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"init\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"pin\"\n        }\n    ],\n    \"colour\": \"#0000ff\"\n};\n\nwindow['Blockly'].Blocks['__YFS401_init'] = {\n    init: function() {\n        this.jsonInit(__YFS401_init_json);\n    }\n};\n\nwindow['Blockly'].Python['__YFS401_init'] = function(block) {\n    var pin = block.getFieldValue('pin');\n    return `import machine, time\nflow_pin = machine.Pin(${pin}, machine.Pin.IN, machine.Pin.PULL_UP)\nyfs401_state = [0, 0]\n\ndef _yfs401_count_pulse(p):\n    yfs401_state[0] += 1\n\nflow_pin.irq(trigger=machine.Pin.IRQ_FALLING, handler=_yfs401_count_pulse)` + \"\\n\";\n};\n\n// Block __YFS401_update\nvar __YFS401_update_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Update\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"interval\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"interval\"\n        }\n    ],\n    \"colour\": \"#0000ff\"\n};\n\nwindow['Blockly'].Blocks['__YFS401_update'] = {\n    init: function() {\n        this.jsonInit(__YFS401_update_json);\n    }\n};\n\nwindow['Blockly'].Python['__YFS401_update'] = function(block) {\n    var interval = block.getFieldValue('interval');\n    return `time.sleep(${interval})\ncount = yfs401_state[0]\nyfs401_state[0] = 0\nyfs401_state[1] = count / 98` + \"\\n\";\n};\n\n// Block __YFS401_lpm\nvar __YFS401_lpm_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"lpm\"\n        }\n    ],\n    \"colour\": \"#0000ff\"\n};\n\nwindow['Blockly'].Blocks['__YFS401_lpm'] = {\n    init: function() {\n        this.jsonInit(__YFS401_lpm_json);\n    }\n};\n\nwindow['Blockly'].Python['__YFS401_lpm'] = function(block) {\n        return [`yfs401_state[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n\n","code":{"init":["window['Blockly'].Python['__YFS401_init'] = function(block) {\n    var pin = block.getFieldValue('pin');\n    return `import machine, time\nflow_pin = machine.Pin(${pin}, machine.Pin.IN, machine.Pin.PULL_UP)\nyfs401_state = [0, 0]\n\ndef _yfs401_count_pulse(p):\n    yfs401_state[0] += 1\n\nflow_pin.irq(trigger=machine.Pin.IRQ_FALLING, handler=_yfs401_count_pulse)` + \"\\n\";\n};\n\n","import machine, time\nflow_pin = machine.Pin(${pin}, machine.Pin.IN, machine.Pin.PULL_UP)\nyfs401_state = [0, 0]\n\ndef _yfs401_count_pulse(p):\n    yfs401_state[0] += 1\n\nflow_pin.irq(trigger=machine.Pin.IRQ_FALLING, handler=_yfs401_count_pulse)"],"update":["window['Blockly'].Python['__YFS401_update'] = function(block) {\n    var interval = block.getFieldValue('interval');\n    return `time.sleep(${interval})\ncount = yfs401_state[0]\nyfs401_state[0] = 0\nyfs401_state[1] = count / 98` + \"\\n\";\n};\n\n","time.sleep(${interval})\ncount = yfs401_state[0]\nyfs401_state[0] = 0\nyfs401_state[1] = count / 98"],"lpm":["window['Blockly'].Python['__YFS401_lpm'] = function(block) {\n        return [`yfs401_state[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n\n","yfs401_state[1]"]}}